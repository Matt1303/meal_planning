# Database
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=meal_planning

# Pipeline configuration override (defaults to config/pipeline.yaml)
PIPELINE_CONFIG=config/pipeline.yaml

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console

# LLM keys (one is required for LLM fallback parsing; otherwise unused)
LLM_API_KEY=

# Nutrition fallback when CoFID does not cover an ingredient
USDA_API_KEY=
